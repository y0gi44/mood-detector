api:
  encryption:
    key: "d2I6l8rn+l6EAuz9n5x/qZaCuPnKaX8MpjCWY9oz7Go="
  reboot_timeout: 24h
  
  actions:
    - action : ventilateur_stop
      then:
        - script.execute: ventilateur_stop
    - action : ventilateur_vitesse1
      then:
        - script.execute: ventilateur_vitesse1
    - action : ventilateur_vitesse2
      then:
        - script.execute: ventilateur_vitesse2
    - action : ventilateur_vitesse3
      then:
        - script.execute: ventilateur_vitesse3

script:
  - id: ventilateur_stop
    then:
        - switch.turn_off: relai_vitesse1
        - switch.turn_off: relai_vitesse2
        - switch.turn_off: relai_vitesse3
  - id: ventilateur_vitesse1
    then:
        - switch.turn_off: relai_vitesse2
        - switch.turn_off: relai_vitesse3
        - switch.turn_on: relai_vitesse1
  - id: ventilateur_vitesse2
    then:
        - switch.turn_off: relai_vitesse1
        - switch.turn_off: relai_vitesse3
        - switch.turn_on: relai_vitesse2
  - id: ventilateur_vitesse3
    then:
        - switch.turn_off: relai_vitesse2
        - switch.turn_off: relai_vitesse1
        - switch.turn_on: relai_vitesse3



