
This directory is intended for project specific (private) libraries.
PlatformIO will compile them to static libraries and link into the executable file.

The source code of each library should be placed in a separate directory
("lib/your_library_name/[Code]").

For example, see the structure of the following example libraries `Foo` and `Bar`:

|--lib
|  |
|  |--Bar
|  |  |--docs
|  |  |--examples
|  |  |--src
|  |     |- Bar.c
|  |     |- Bar.h
|  |  |- library.json (optional. for custom build options, etc) https://docs.platformio.org/page/librarymanager/config.html
|  |
|  |--Foo
|  |  |- Foo.c
|  |  |- Foo.h
|  |
|  |- README --> THIS FILE
|
|- platformio.ini
|--src
   |- main.c

Example contents of `src/main.c` using Foo and Bar:
```
#include <Foo.h>
#include <Bar.h>

int main (void)
{
  ...
}

```

The PlatformIO Library Dependency Finder will find automatically dependent
libraries by scanning project source files.

More information about PlatformIO Library Dependency Finder
- https://docs.platformio.org/page/librarymanager/ldf.html





esphome:
  name: esp-rfid3
  friendly_name: esp_rfid3

substitutions: 
  module_name: feu

esp32:
  board: wemos_d1_mini32
  framework:
    type: arduino

# Enable logging
logger:

mqtt:
  id: mqtt_client
  topic_prefix: boat
  discovery: false
  broker: 192.168.1.102
  port: 1883
  username: !secret mqtt_username
  password: !secret mqtt_password
  discovery_prefix: modules
  birth_message:
    topic: modules/${module_name}/events
    payload: online
  will_message:
    topic: modules/${module_name}/events
    payload: disconnected
  shutdown_message:
    topic: modules/${module_name}/events
    payload: offline
  on_json_message:
    topic: modules/${module_name}/state
    qos: 0
    then:
      - lambda: |-
          if (x["ventilateur"].is<int>()){
            int vitesse = x["ventilateur"];
            switch(vitesse) {
              case 0: 
                id(ventilateur_stop).execute();
                break;
              case 1: 
                id(ventilateur_vitesse1).execute();
                break;
              case 2: 
                id(ventilateur_vitesse2).execute();
                break;
              case 3: 
                id(ventilateur_vitesse3).execute();
                break;
            }
          }
          if (x["lumiere"].is<JsonObject>() ){
            if (x["lumiere"]["couleur"].is<String>() ){
              String couleur = x["lumiere"]["couleur"];

              auto call = id(led_strip).turn_on();
              if (couleur == "jaune") {
                call.set_rgb(1,1,0);
              }else if (couleur == "bleu") {
                call.set_rgb(0,0,1);
              }else if (couleur == "vert") {
                call.set_rgb(0,1,0);
              }else if (couleur == "rouge") {
                call.set_rgb(1,0,0);
              }else if (couleur == "blanc") {
                call.set_rgb(1,1,1);
              } else { // noir on éteint
                call.set_rgb(0,0,0);
              }
              call.set_transition_length(2000); // in ms
              call.set_brightness(0.8); 
              call.perform();
            }
            else{
              if (x["lumiere"]["state"].is<String>() && x["lumiere"]["state"] == "off"){
                id(led_strip).turn_off().perform();
              }
              else {
                auto call = id(led_strip).turn_on();
                call.set_transition_length(2000); // in ms
                
                if (x["lumiere"]["R"].is<double>() && x["lumiere"]["G"].is<double>() && x["lumiere"]["B"].is<double>()) {
                  call.set_rgb(x["lumiere"]["R"], x["lumiere"]["G"], x["lumiere"]["B"]); // RGB order
                }
                
                
                double brightness = 0.8;
                if (x["lumiere"]["brightness"].is<double>())
                  brightness = x["lumiere"]["brightness"];
                
                call.set_brightness(0.8); 

                //id(led_strip).turn_on().set_.set_brightness(brightness).perform();
                
                /*if (y.containsKey["effect"]){
                  String effect = y["effect"];
                  call.set_effect(effect);
                }*/
                call.perform();
              }
            }
          }

  on_message:
    - topic: modules/${module_name}/state
      qos: 0
      payload: "{ 'ventilateur': 0 }"
      then:
        - script.execute: ventilateur_stop
  
    - topic: modules/${module_name}/state
      qos: 0
      payload: "{ 'ventilateur': 1 }"
      then:
        - script.execute: ventilateur_vitesse1
    - topic: modules/${module_name}/state
      qos: 0
      payload: "{ 'ventilateur': 2 }"
      then:
        - script.execute: ventilateur_vitesse2
  
    - topic: modules/${module_name}/state
      qos: 0
      payload: "{ 'ventilateur': 3 }"
      then:
        - script.execute: ventilateur_vitesse3
    - topic: modules/${module_name}/state
      qos: 0
      payload: "{ 'couleur': 'jaune'}"
      then:
        - light.addressable_set:
            id: led_strip
            range_from: 0
            range_to: 7
            color_brightness: 50%
            red: 100%
            green: 100%
            blue: 0%
    - topic: modules/${module_name}/state
      qos: 0
      payload: "{ 'couleur': 'bleu'}"
      then:
        - light.addressable_set:
            id: led_strip
            range_from: 0
            range_to: 15
            color_brightness: 70%
            red: 0%
            green: 0%
            blue: 100%
    - topic: modules/${module_name}/state
      qos: 0
      payload: "{ 'couleur': 'vert'}"
      then:
        - light.addressable_set:
            id: led_strip
            range_from: 0
            range_to: 23
            color_brightness: 90%
            red: 0%
            green: 100%
            blue: 0%
    - topic: modules/${module_name}/state
      qos: 0
      payload: "{ 'couleur': 'blanc'}"
      then:
        - light.addressable_set:
            id: led_strip
            range_from: 0
            range_to: 23
            color_brightness: 95%
            red: 100%
            green: 100%
            blue: 100%
    - topic: modules/${module_name}/state
      qos: 0
      payload: "{ 'couleur': 'noir'}"
      then:
        - light.addressable_set:
            id: led_strip
            range_from: 0
            range_to: 8
            red: 0%
            green: 0%
            blue: 0%

